{
    "name": "slova/module-blog",
    "description": "Free blog for Magento 2 on Hyvä: posts and categories, related products, clean URLs with your own prefix, WebP images, Article and BreadcrumbList structured data, sitemap, zero layout shift.",
    "type": "magento2-module",
    "version": "1.1.0",
    "license": "MIT",
    "keywords": [
        "magento2",
        "hyva",
        "blog",
        "magento2-blog",
        "content-marketing",
        "seo",
        "webp"
    ],
    "authors": [
        {
            "name": "Slova (Carusel Multimedia SRL)",
            "homepage": "https://github.com/SlovaTechModules"
        }
    ],
    "require": {
        "php": "~8.3.0||~8.4.0",
        "ext-gd": "*",
        "ext-intl": "*",
        "magento/framework": "^103.0.8",
        "magento/module-backend": "^102.0.8",
        "magento/module-catalog": "^104.0.8",
        "magento/module-cms": "^104.0.8",
        "magento/module-config": "^101.2.8",
        "magento/module-sitemap": "^100.4.7",
        "magento/module-store": "^101.1.8",
        "magento/module-theme": "^101.1.8",
        "magento/module-ui": "^101.2.8",
        "magento/module-url-rewrite": "^102.0.7",
        "magento/module-widget": "^101.2.8",
        "hyva-themes/magento2-theme-module": "^1.4"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Slova\\Blog\\": ""
        }
    }
}
