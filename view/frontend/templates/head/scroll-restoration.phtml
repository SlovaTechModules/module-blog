<?php
/**
 * Slova_Blog — scroll restoration „manual" la RELOAD, în <head>, pe paginile de blog.
 *
 * Pe mobil, scrollat în jos + hard refresh: conținutul de jos (infinite scroll pe listă,
 * imagini lazy pe articol) nu mai e încărcat → pagina e scurtă → scroll restoration al
 * browserului nu ajunge la poziția salvată → arată vârful (banda + primul element), apoi
 * sare = „horror" (ghosting + CLS, dar DevTools nu-l prinde — e scroll-position, nu CLS).
 *
 * DOAR la reload: browserul NU restaurează → rămâi sus (ca la PDP). Navigare/back rămân pe
 * auto (back restaurează normal). Reset la pagehide → 'auto'-ul global pe restul site-ului
 * e neatins. Scoped: inclus doar pe layout-urile de blog listă + articol.
 */
declare(strict_types=1);
?>
<script>
if ('scrollRestoration' in history) {
    var srNav = performance.getEntriesByType('navigation')[0];
    if (srNav && srNav.type === 'reload') {
        history.scrollRestoration = 'manual';
    }
    addEventListener('pagehide', function () {
        if (history.scrollRestoration === 'manual') history.scrollRestoration = 'auto';
    });
}
</script>
