<style>
    .slova-blog-heading {
        margin: 0 0 1.5rem;
        font-size: 1.75rem;
        line-height: 1.2;
        font-weight: 700;
        color: var(--slova-blog-fg);
    }
    .slova-blog-empty {
        padding: 3rem 1rem;
        text-align: center;
        color: var(--slova-blog-muted);
    }
    .slova-blog-list {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .slova-blog-list > li { display: contents; }

    .slova-blog-card {
        display: grid;
        grid-template-columns: 120px minmax(0, 1fr);
        gap: 1rem;
        padding: 1rem;
        border: 2px solid var(--slova-blog-card-border);
        border-radius: var(--slova-blog-radius);
        background: var(--slova-blog-surface);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .slova-blog-card:hover {
        border-color: var(--slova-blog-card-border-hover);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px color-mix(in srgb, var(--slova-blog-accent) 14%, transparent);
    }
    .slova-blog-card__thumb {
        display: block;
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 0.5rem;
    }
    .slova-blog-card__thumb picture,
    .slova-blog-card__thumb img,
    .slova-blog-card__img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    .slova-blog-card__placeholder {
        display: block;
        width: 100%;
        height: 100%;
        background: var(--slova-blog-pill-bg);
    }
    .slova-blog-card__body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
    }
    .slova-blog-card__title {
        display: -webkit-box;
        margin: 0;
        min-height: calc(1.3em * 2);
        overflow: hidden;
        font-size: 1.125rem;
        line-height: 1.3;
        font-weight: 600;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
    }
    .slova-blog-card__title a {
        color: var(--slova-blog-fg);
        text-decoration: none;
    }
    .slova-blog-card__title a:hover { color: var(--slova-blog-accent); }
    .slova-blog-card__excerpt {
        display: -webkit-box;
        margin: 0;
        min-height: calc(1.5em * 2);
        overflow: hidden;
        font-size: 0.875rem;
        line-height: 1.5;
        color: var(--slova-blog-muted);
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
    }
    .slova-blog-card__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: auto;
    }

    /* Phones: the next pages load while scrolling, so the pager is hidden. */
    .slova-blog-pager {
        display: none;
        justify-content: center;
        margin-top: 2rem;
    }
    .slova-blog-scroll-sentinel { height: 1px; }
    .slova-blog-scroll-status {
        padding: 1.5rem 0;
        text-align: center;
        font-size: 0.875rem;
        color: var(--slova-blog-muted);
    }
    .slova-blog-scroll-status[hidden] { display: none; }
    .slova-blog-scroll-status__spinner {
        display: inline-block;
        width: 1.25rem;
        height: 1.25rem;
        margin-right: 0.5rem;
        vertical-align: middle;
        border: 2px solid var(--slova-blog-card-border);
        border-top-color: var(--slova-blog-accent);
        border-radius: 50%;
        animation: slova-blog-spin 0.7s linear infinite;
    }
    @keyframes slova-blog-spin { to { transform: rotate(360deg); } }

    @media (min-width: 640px) {
        .slova-blog-list { gap: 1.25rem; }
        .slova-blog-card {
            grid-template-columns: 160px minmax(0, 1fr);
            gap: 1.25rem;
            padding: 1.25rem;
        }
        .slova-blog-card__title { font-size: 1.25rem; }
    }

    /* Tablet (768px and up): two columns of vertical cards, pager instead of scrolling. */
    @media (min-width: 768px) {
        .slova-blog-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .slova-blog-card {
            grid-template-columns: minmax(0, 1fr);
            gap: 1rem;
        }
        .slova-blog-card__thumb { aspect-ratio: 16 / 9; }
