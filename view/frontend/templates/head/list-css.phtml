<?php
/**
 * Slova_Blog — CSS critic pentru lista de articole, randat în <head>.
 *
 * Trebuie să stea în <head> (NU inline în body) ca regulile de geometrie
 * (grid carduri + rezervarea cutiei imaginii) să fie în CSSOM înainte de
 * primul paint. Altfel prima imagine (eager/fetchpriority=high) se pictează
 * la dimensiunea ei naturală înainte ca stilul din body să fie parsat → CLS.
 */
declare(strict_types=1);
?>
<style>
    .slova-blog-empty {
        padding: 3rem 1rem;
        text-align: center;
        color: #6b7280;
    }

    .slova-blog-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .slova-blog-list > li {
        display: contents;
    }

    .slova-blog-card {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 1rem;
        padding: 1rem;
        background: #fff;
        border: 2px solid #D0E5E5;
        border-radius: 0.75rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .slova-blog-card:hover {
        border-color: transparent;
        background-image:
            linear-gradient(#fff, #fff),
            linear-gradient(135deg, var(--color-primary, #009999), var(--color-secondary, #FF5533));
        background-origin: border-box;
        background-clip: padding-box, border-box;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 153, 153, 0.12);
    }

    .slova-blog-card__thumb {
        display: block;
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 0.5rem;
        background: transparent;
    }

    .slova-blog-card__img,
    .slova-blog-card__thumb picture,
    .slova-blog-card__thumb img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    .slova-blog-card__placeholder {
        display: block;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
    }

    .slova-blog-card__body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
    }

    .slova-blog-card__title {
        font-size: 1.125rem;
        line-height: 1.3;
        font-weight: 600;
        margin: 0;
        min-height: calc(1.3em * 2);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .slova-blog-card__title a {
        color: var(--color-dark, #111e1e);
        text-decoration: none;
    }

    .slova-blog-card__title a:hover {
        color: var(--color-primary, #009999);
    }

    .slova-blog-card__excerpt {
        font-size: 0.875rem;
        line-height: 1.5;
        color: #4b5563;
        margin: 0;
        min-height: calc(1.5em * 2);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .slova-blog-card__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 0.75rem;
        font-size: 0.8125rem;
        color: #6b7280;
        margin-top: auto;
    }

    .slova-blog-card__category {
        display: inline-flex;
        align-items: center;
        padding: 0.125rem 0.625rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--color-primary, #009999);
        background: rgba(0, 153, 153, 0.08);
        text-decoration: none;
    }

    .slova-blog-card__category:hover {
        background: rgba(0, 153, 153, 0.16);
    }

    .slova-blog-card__date::before {
        content: "·";
        margin-right: 0.5rem;
        color: #9ca3af;
    }

    .slova-blog-card__meta > :first-child.slova-blog-card__date::before {
        content: none;
    }

    .slova-blog-pager {
        margin-top: 2rem;
        display: flex;
        justify-content: center;
    }

    @media (min-width: 640px) {
        .slova-blog-list {
            gap: 1.25rem;
        }
        .slova-blog-card {
            grid-template-columns: 160px 1fr;
            gap: 1.25rem;
            padding: 1.25rem;
        }
        .slova-blog-card__title {
            font-size: 1.25rem;
        }
    }

    /* Tabletă (768–1279px): 2 coloane, carduri verticale ca pe desktop.
       Sub 768px rămâne layoutul orizontal pe 1 coloană (mobil). */
    @media (min-width: 768px) {
        .slova-blog-list {
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
        }
        .slova-blog-card {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
        .slova-blog-card__thumb {
            aspect-ratio: 16 / 9;
        }
        .slova-blog-card__title {
            font-size: 1.125rem;
        }
    }

    /* Desktop (≥1280px): 3 coloane (cardurile sunt deja verticale din regula de tabletă). */
    @media (min-width: 1280px) {
        .slova-blog-list {
            grid-template-columns: 1fr 1fr 1fr;
        }
    }
</style>
