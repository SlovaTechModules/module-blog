<?php
/**
 * Slova_Blog — widget "Latest Posts". Styles are scoped to the widget and come before
 * its markup, so the cards have their size at first paint wherever the widget is placed.
 * Override the --slova-blog-* properties on .slova-blog-widget in your theme to restyle.
 * Copyright © Slova. Licensed under the MIT License, see LICENSE.
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Slova\Blog\Block\Widget\LatestPosts;

/** @var LatestPosts $block */
/** @var Escaper $escaper */

$posts = $block->getPosts();
if (!$posts) {
    return;
}
$title = $block->getTitle();
$allUrl = $block->getAllPostsUrl();
$accent = $block->getAccentColor();
$cover = $block->getCardImageFit() === 'cover';
?>
<style>
    .slova-blog-widget {
        --slova-blog-accent: <?= /* @noEscape */ $accent !== '' ? $accent : 'var(--color-primary, #1d4ed8)' ?>;
        --slova-blog-fg: var(--color-fg, #111827);
        --slova-blog-muted: var(--color-fg-secondary, #6b7280);
        --slova-blog-card-border: color-mix(in srgb, var(--slova-blog-accent) 18%, #fff);
        --slova-blog-card-fit: <?= /* @noEscape */ $cover ? 'cover' : 'contain' ?>;
        --slova-blog-card-position: <?= /* @noEscape */ $cover ? '50% 0' : '50% 50%' ?>;
        margin: 2.5rem 0;
    }
    .slova-blog-widget__head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        margin-bottom: 1.25rem;
    }
    .slova-blog-widget__title {
        margin: 0;
        font-size: 1.5rem;
        line-height: 1.25;
        font-weight: 700;
        color: var(--slova-blog-fg);
    }
    .slova-blog-widget__all {
        font-weight: 600;
        color: var(--slova-blog-accent);
        text-decoration: none;
    }
    .slova-blog-widget__all:hover { text-decoration: underline; }
    .slova-blog-widget__list {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .slova-blog-widget__card {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        border: 2px solid var(--slova-blog-card-border);
        border-radius: 0.75rem;
        background: #fff;
        color: inherit;
        text-decoration: none;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .slova-blog-widget__card:hover {
        border-color: var(--slova-blog-accent);
        transform: translateY(-2px);
    }
    .slova-blog-widget__thumb {
        display: block;
        aspect-ratio: 16 / 9;
        overflow: hidden;
    }
    .slova-blog-widget__thumb picture,
    .slova-blog-widget__img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: var(--slova-blog-card-fit);
        object-position: var(--slova-blog-card-position);
    }
    .slova-blog-widget__placeholder {
        display: block;
        height: 100%;
        background: color-mix(in srgb, var(--slova-blog-accent) 9%, transparent);
    }
    .slova-blog-widget__body {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        padding: 1rem 1.25rem 1.25rem;
    }
    .slova-blog-widget__date {
        font-size: 0.8125rem;
        color: var(--slova-blog-muted);
    }
    .slova-blog-widget__post-title {
        margin: 0;
        font-size: 1.125rem;
        line-height: 1.3;
        font-weight: 600;
        color: var(--slova-blog-fg);
    }
    .slova-blog-widget__card:hover .slova-blog-widget__post-title { color: var(--slova-blog-accent); }
    .slova-blog-widget__excerpt {
        display: -webkit-box;
        margin: 0;
        overflow: hidden;
        font-size: 0.875rem;
        line-height: 1.5;
        color: var(--slova-blog-muted);
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
    }
    @media (min-width: 768px) {
        .slova-blog-widget__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (min-width: 1024px) {
        .slova-blog-widget__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
</style>
<section class="slova-blog-widget"<?= $title !== '' ? ' aria-label="' . $escaper->escapeHtmlAttr($title) . '"' : '' ?>>
    <?php if ($title !== '' || $allUrl !== ''): ?>
        <div class="slova-blog-widget__head">
            <?php if ($title !== ''): ?>
                <h2 class="slova-blog-widget__title"><?= $escaper->escapeHtml($title) ?></h2>
            <?php endif; ?>
            <?php if ($allUrl !== ''): ?>
                <a class="slova-blog-widget__all" href="<?= $escaper->escapeUrl($allUrl) ?>"><?= $escaper->escapeHtml(__('View all posts')) ?> →</a>
            <?php endif; ?>
        </div>
    <?php endif; ?>
    <ul class="slova-blog-widget__list" role="list">
        <?php foreach ($posts as $post): ?>
            <li>
                <a class="slova-blog-widget__card" href="<?= $escaper->escapeUrl($block->getPostUrl($post)) ?>">
                    <span class="slova-blog-widget__thumb"><?= /* @noEscape */ $block->getImageHtml($post) ?></span>
                    <span class="slova-blog-widget__body">
                        <?php $date = $block->getFormattedDate($post); ?>
                        <?php if ($date !== ''): ?>
                            <time class="slova-blog-widget__date" datetime="<?= $escaper->escapeHtml($block->getIsoDate($post)) ?>"><?= $escaper->escapeHtml($date) ?></time>
                        <?php endif; ?>
                        <span class="slova-blog-widget__post-title"><?= $escaper->escapeHtml($post->getTitle()) ?></span>
                        <?php if ($block->isExcerptShown() && trim((string)$post->getShortContent()) !== ''): ?>
                            <span class="slova-blog-widget__excerpt"><?= $escaper->escapeHtml(trim((string)$post->getShortContent())) ?></span>
                        <?php endif; ?>
                    </span>
                </a>
            </li>
        <?php endforeach; ?>
    </ul>
</section>
