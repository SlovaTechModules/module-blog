<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Slova\Blog\Block\Sidebar\Categories;

/** @var Categories $block */
/** @var Escaper $escaper */

$categories = $block->getCategories();
if (!$categories) {
    return;
}
?>

<aside class="slova-blog-sidebar-categories"
       x-data="{ open: false }"
       @click.outside="open = false"
       @keydown.escape="open = false"
       aria-label="<?= $escaper->escapeHtmlAttr(__('Categorii de articole')) ?>">
    <button type="button"
            class="slova-blog-sidebar-categories__toggle"
            @click="open = !open"
            :aria-expanded="open ? 'true' : 'false'">
        <span class="slova-blog-sidebar-categories__title">
            <?= $escaper->escapeHtml(__('Categorii de articole')) ?>
        </span>
        <svg class="slova-blog-sidebar-categories__chevron" :class="{ 'is-open': open }"
             viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
        </svg>
    </button>
    <div class="slova-blog-sidebar-categories__collapse" :class="{ 'is-open': open }">
        <div class="slova-blog-sidebar-categories__collapse-inner">
            <ul class="slova-blog-sidebar-categories__list">
                <li class="slova-blog-sidebar-categories__item<?= $block->isAllActive() ? ' is-current' : '' ?>">
                    <a href="<?= $escaper->escapeUrl($block->getAllPostsUrl()) ?>">
                        <span class="slova-blog-sidebar-categories__name"><?= $escaper->escapeHtml(__('Toate articolele')) ?></span>
                        <span class="slova-blog-sidebar-categories__count">(<?= (int)$block->getTotalPostCount() ?>)</span>
                    </a>
                </li>
                <?php foreach ($categories as $category): ?>
                    <?php $count = $block->getPostCount($category); ?>
                    <li class="slova-blog-sidebar-categories__item<?= $block->isCurrent($category) ? ' is-current' : '' ?>">
                        <a href="<?= $escaper->escapeUrl($block->getCategoryUrl($category)) ?>">
                            <span class="slova-blog-sidebar-categories__name"><?= $escaper->escapeHtml($category->getName()) ?></span>
                            <span class="slova-blog-sidebar-categories__count">(<?= (int)$count ?>)</span>
                        </a>
                    </li>
                <?php endforeach; ?>
            </ul>
        </div>
    </div>
</aside>
