<?php
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductListItem;
use Magento\Catalog\Block\Product\ReviewRendererInterface as ProductReviewRenderer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Slova\Blog\Block\PostView;
use Slova\Imaging\ViewModel\Image as ImageVm;

/** @var PostView $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var ImageVm $imageVm */
$imageVm = $viewModels->require(ImageVm::class);

/** @var ProductListItem $productListItemViewModel */
$productListItemViewModel = $viewModels->require(ProductListItem::class);

$post = $block->getPost();
if (!$post) {
    return;
}

$imgPath = $block->getFeaturedImagePath();
$categories = $block->getCategories();
$relatedProducts = $block->getRelatedProducts();
$date = $block->getFormattedDate();
$isoDate = $block->getIsoDate();
$canonicalUrl = $block->getCanonicalUrl();
$ogImage = $block->getOgImageUrl();

$itemRenderer = $block->getLayout()->getBlock('product_list_item')
    ?: $block->getLayout()->createBlock(Template::class);
?>

<article class="slova-blog-post" itemscope itemtype="https://schema.org/Article">
    <meta itemprop="mainEntityOfPage" content="<?= $escaper->escapeHtmlAttr($canonicalUrl) ?>">

    <header class="slova-blog-post__header">
        <h1 class="slova-blog-post__title" itemprop="headline">
            <?= $escaper->escapeHtml($post->getTitle()) ?>
        </h1>
        <div class="slova-blog-post__meta">
            <?php foreach ($categories as $cat): ?>
                <a href="<?= $escaper->escapeUrl($block->getCategoryUrl((string)$cat->getUrlKey())) ?>"
                   class="slova-blog-post__category">
                    <?= $escaper->escapeHtml($cat->getName()) ?>
                </a>
            <?php endforeach; ?>
            <?php if ($date): ?>
                <time class="slova-blog-post__date" datetime="<?= $escaper->escapeHtmlAttr($isoDate) ?>" itemprop="datePublished">
                    <?= $escaper->escapeHtml($date) ?>
                </time>
            <?php endif; ?>
        </div>
    </header>

    <?php if ($block->hasSideSection()):
        $sideText = $block->getSanitizedSideText();
        $sideImgPath = $block->getSideImagePath();
        $sideAlt = $block->getSideImageAlt() ?: $post->getTitle();
    ?>
        <section class="slova-blog-post__intro">
            <?php if ($sideText !== ''): ?>
                <div class="slova-blog-post__intro-text">
                    <?= /* @noEscape */ $sideText ?>
                </div>
            <?php endif; ?>
            <?php if ($sideImgPath !== ''): ?>
                <div class="slova-blog-post__intro-image">
                    <?= /* @noEscape */ $imageVm->picture(
                        $sideImgPath,
                        480,
                        alt: (string)$sideAlt,
                        loading: $block->shouldShowFeaturedImage() ? 'lazy' : 'eager',
                        fetchPriority: $block->shouldShowFeaturedImage() ? 'auto' : 'high'
                    ) ?>
                </div>
            <?php endif; ?>
        </section>
    <?php endif; ?>

    <?php if ($block->shouldShowFeaturedImage()): ?>
        <figure class="slova-blog-post__hero">
            <?= /* @noEscape */ $imageVm->picture(
                $imgPath,
                900,
                alt: (string)($post->getFeaturedImageAlt() ?: $post->getTitle()),
                loading: 'eager',
                fetchPriority: 'high',
                imgClass: 'slova-blog-post__hero-img'
            ) ?>
        </figure>
    <?php endif; ?>

    <div class="slova-blog-post__content" itemprop="articleBody">
        <?= /* @noEscape */ $block->getProcessedContent() ?>
    </div>
</article>

<?php $prevPost = $block->getPreviousPost(); $nextPost = $block->getNextPost(); ?>
<?php if ($prevPost || $nextPost): ?>
    <nav class="slova-blog-post__nav" aria-label="<?= $escaper->escapeHtmlAttr(__('Navigare articole')) ?>">
        <?php if ($prevPost): ?>
            <a href="<?= $escaper->escapeUrl($prevPost['url']) ?>" class="slova-blog-post__nav-link slova-blog-post__nav-prev" rel="prev">
                <span class="slova-blog-post__nav-label">← <?= $escaper->escapeHtml(__('Articol anterior')) ?></span>
                <span class="slova-blog-post__nav-title"><?= $escaper->escapeHtml($prevPost['title']) ?></span>
            </a>
        <?php else: ?>
            <span></span>
        <?php endif; ?>
        <?php if ($nextPost): ?>
            <a href="<?= $escaper->escapeUrl($nextPost['url']) ?>" class="slova-blog-post__nav-link slova-blog-post__nav-next" rel="next">
                <span class="slova-blog-post__nav-label"><?= $escaper->escapeHtml(__('Articol următor')) ?> →</span>
                <span class="slova-blog-post__nav-title"><?= $escaper->escapeHtml($nextPost['title']) ?></span>
            </a>
        <?php else: ?>
            <span></span>
        <?php endif; ?>
    </nav>
<?php endif; ?>

<?php if (!empty($relatedProducts)): ?>
    <?php $sliderName = 'slova-blog-related-' . (int)$post->getId(); ?>
    <section class="slova-blog-related"
             id="<?= $escaper->escapeHtmlAttr($sliderName) ?>"
             aria-label="<?= $escaper->escapeHtmlAttr(__('File din povestea')) ?>"
             x-data
             x-snap-slider.auto-pager.group-pager
             x-defer="intersect">
        <div class="slova-blog-related__head">
            <h2 class="slova-blog-related__title">
                <?= $escaper->escapeHtml(__('File din povestea')) ?>
            </h2>
        </div>
        <div class="snap-track md:[--snap-cols:2] lg:[--snap-cols:3] xl:[--snap-cols:4]"
             data-track tabindex="0" aria-live="polite">
            <?php foreach ($relatedProducts as $product): ?>
                <div class="flex flex-col slider-card" role="tabpanel">
                    <?= /* @noEscape */ $productListItemViewModel->getItemHtmlWithRenderer(
                        $itemRenderer,
                        $product,
                        $block,
                        'grid',
                        ProductReviewRenderer::SHORT_VIEW,
                        'category_page_grid',
                        false
                    ) ?>
                </div>
            <?php endforeach; ?>
        </div>
        <div class="snap-pager" data-pager></div>
    </section>
<?php endif; ?>

