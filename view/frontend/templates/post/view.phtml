 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductListItem;
use Magento\Catalog\Block\Product\ReviewRendererInterface;
use Magento\Framework\Escaper;
use Slova\Blog\Block\PostView;
use Slova\Blog\ViewModel\Image;

/** @var PostView $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$post = $block->getPost();
if (!$post) {
    return;
}

/** @var Image $imageVm */
$imageVm = $block->getData('image_view_model');
$date = $block->getFormattedDate();
$showHero = $block->shouldShowFeaturedImage();
?>
<article class="slova-blog-post">
    <header class="slova-blog-post__header">
        <h1 class="slova-blog-post__title"><?= $escaper->escapeHtml($post->getTitle()) ?></h1>
        <div class="slova-blog-post__meta">
            <?php foreach ($block->getCategories() as $category): ?>
                <a href="<?= $escaper->escapeUrl($block->getCategoryUrl((string)$category->getUrlKey())) ?>"
                   class="slova-blog-pill"><?= $escaper->escapeHtml($category->getName()) ?></a>
            <?php endforeach; ?>
            <?php if ($date !== ''): ?>
                <time class="slova-blog-post__date" datetime="<?= $escaper->escapeHtml($block->getIsoDate()) ?>">
                    <?= $escaper->escapeHtml($date) ?>
                </time>
            <?php endif; ?>
        </div>
    </header>

    <?php if ($block->hasSideSection()): ?>
        <?php
        $sideText = $block->getSanitizedSideText();
        $sideImgPath = $block->getSideImagePath();
        ?>
        <section class="slova-blog-post__intro<?= $sideText === '' || $sideImgPath === '' ? ' is-single' : '' ?>">
            <?php if ($sideText !== ''): ?>
                <div class="slova-blog-post__intro-text"><?= /* @noEscape */ $sideText ?></div>
            <?php endif; ?>
            <?php if ($sideImgPath !== ''): ?>
                <div class="slova-blog-post__intro-image">
                    <?= /* @noEscape */ $imageVm->picture(
                        $sideImgPath,
                        480,
                        alt: $block->getSideImageAlt() ?: (string)$post->getTitle(),
                        loading: $showHero ? 'lazy' : 'eager',
                        fetchPriority: $showHero ? 'auto' : 'high'
                    ) ?>
                </div>
            <?php endif; ?>
        </section>
    <?php endif; ?>

    <?php if ($showHero): ?>
        <figure class="slova-blog-post__hero">
            <?= /* @noEscape */ $imageVm->picture(
                $block->getFeaturedImagePath(),
                900,
                alt: (string)($post->getFeaturedImageAlt() ?: $post->getTitle()),
                loading: 'eager',
                fetchPriority: 'high',
                imgClass: 'slova-blog-post__hero-img'
            ) ?>
        </figure>
    <?php endif; ?>

    <div class="slova-blog-post__content">
        <?= /* @noEscape */ $block->getProcessedContent() ?>
    </div>
</article>

<?php
$prevPost = $block->getPreviousPost();
$nextPost = $block->getNextPost();
?>
<?php if ($prevPost || $nextPost): ?>
    <nav class="slova-blog-post__nav" aria-label="<?= $escaper->escapeHtmlAttr(__('Post navigation')) ?>">
        <?php if ($prevPost): ?>
            <a href="<?= $escaper->escapeUrl($prevPost['url']) ?>" class="slova-blog-post__nav-link" rel="prev">
                <span class="slova-blog-post__nav-label">← <?= $escaper->escapeHtml(__('Previous post')) ?></span>
                <span class="slova-blog-post__nav-title"><?= $escaper->escapeHtml($prevPost['title']) ?></span>
            </a>
        <?php else: ?>
            <span></span>
        <?php endif; ?>
        <?php if ($nextPost): ?>
            <a href="<?= $escaper->escapeUrl($nextPost['url']) ?>" class="slova-blog-post__nav-link slova-blog-post__nav-link--next" rel="next">
                <span class="slova-blog-post__nav-label"><?= $escaper->escapeHtml(__('Next post')) ?> →</span>
                <span class="slova-blog-post__nav-title"><?= $escaper->escapeHtml($nextPost['title']) ?></span>
            </a>
        <?php endif; ?>
    </nav>
<?php endif; ?>

<?php $relatedProducts = $block->getRelatedProducts(); ?>
<?php if ($relatedProducts): ?>
    <?php
    /** @var ProductListItem $productListItem */
    $productListItem = $viewModels->require(ProductListItem::class);
    $itemRenderer = $block->getLayout()->getBlock('product_list_item');
    $relatedTitle = $block->getRelatedTitle();
    ?>
    <?php if ($itemRenderer): ?>
        <section class="slova-blog-related snap-slider"
                 aria-label="<?= $escaper->escapeHtmlAttr($relatedTitle) ?>"
                 x-data
                 x-snap-slider.auto-pager.group-pager
                 x-defer="intersect">
            <h2 class="slova-blog-related__title"><?= $escaper->escapeHtml($relatedTitle) ?></h2>
            <div class="snap-track" data-track tabindex="0">
                <?php foreach ($relatedProducts as $product): ?>
                    <div class="slova-blog-related__item">
                        <?= /* @noEscape */ $productListItem->getItemHtmlWithRenderer(
                            $itemRenderer,
                            $product,
                            $block,
                            'grid',
                            ReviewRendererInterface::SHORT_VIEW,
                            'category_page_grid',
                            false
                        ) ?>
                    </div>
                <?php endforeach; ?>
            </div>
            <div class="snap-pager" data-pager></div>
        </section>
    <?php endif; ?>
<?php endif; ?>
