<?php
/**
 * Infinite scroll for mobile blog listing.
 * Only active below md breakpoint (768px).
 * Mirrors Magento_Catalog catalog list infinite-scroll pattern.
 */

use Magento\Framework\Escaper;
use Slova\Blog\Block\PostList;

/** @var PostList $block */
/** @var Escaper $escaper */
?>

<style>
.infinite-scroll-sentinel { height: 1px; }
.infinite-scroll-status {
    text-align: center;
    padding: 1.5rem 0;
    color: #888;
    font-size: 0.875rem;
}
.infinite-scroll-spinner {
    display: inline-block;
    width: 1.5rem;
    height: 1.5rem;
    border: 2.5px solid #CCF0F0;
    border-top-color: #009999;
    border-radius: 50%;
    animation: inf-spin 0.7s linear infinite;
}
@keyframes inf-spin { to { transform: rotate(360deg); } }

@media (min-width: 768px) {
    .infinite-scroll-status { display: none !important; }
}
</style>

<div id="infinite-scroll-loader" class="infinite-scroll-status" style="display:none">
    <span class="infinite-scroll-spinner"></span>
    <span style="margin-left:0.5rem"><?= $escaper->escapeHtml(__('Se încarcă...')) ?></span>
</div>
<div id="infinite-scroll-end" class="infinite-scroll-status" style="display:none">
    <?= $escaper->escapeHtml(__('Ai văzut toate articolele')) ?>
</div>
<div id="infinite-scroll-sentinel" class="infinite-scroll-sentinel"></div>

<script>
(function() {
    'use strict';

    var MD_BREAKPOINT = 768;
    var STORAGE_KEY = 'infiniteScroll_' + window.location.pathname + window.location.search.replace(/[&?]p=\d+/g, '');

    function isMobile() {
        return window.innerWidth < MD_BREAKPOINT;
    }

    var section = document.getElementById('product-list');
    if (!section) return;

    var currentPage = parseInt(section.getAttribute('data-current-page')) || 1;
    var lastPage = parseInt(section.getAttribute('data-last-page')) || 1;
    var grid = document.getElementById('product-grid');
    var sentinel = document.getElementById('infinite-scroll-sentinel');
    var loader = document.getElementById('infinite-scroll-loader');
    var endMsg = document.getElementById('infinite-scroll-end');
    var loading = false;
    var nextPage = currentPage + 1;

    function tryRestore() {
        if (!isMobile()) return false;
        // Hard refresh: NU restaura. tryRestore face append de articole + scrollTo(scrollY)
        // DUPĂ primul paint → pagina „sare" masiv + ghosting (mobil-only, exact simptomul
        // raportat). La reload pornim fresh (pagina 1, sus). Back/forward restaurează normal.
        var navEntry = performance.getEntriesByType('navigation')[0];
        if (navEntry && navEntry.type === 'reload') return false;
        try {
            var saved = sessionStorage.getItem(STORAGE_KEY);
            if (!saved) return false;
            var data = JSON.parse(saved);
            if (!data.html || !data.nextPage) return false;

            var urlPage = new URLSearchParams(window.location.search).get('p');
            if (urlPage && parseInt(urlPage) > 1) return false;

            grid.insertAdjacentHTML('beforeend', data.html);
            nextPage = data.nextPage;

            if (nextPage > lastPage) {
                endMsg.style.display = '';
            }

            requestAnimationFrame(function() {
                if (data.scrollY) {
                    window.scrollTo(0, data.scrollY);
                }
            });

            reinitAlpine();

            return true;
        } catch(e) {
            return false;
        }
    }

    function saveState() {
        if (!isMobile()) return;
        if (nextPage <= currentPage + 1) return;

        try {
            var allItems = grid.querySelectorAll(':scope > li');
            var originalCount = <?= (int) $block->getLoadedItemsCount() ?>;

            var appendedHtml = '';
            for (var i = originalCount; i < allItems.length; i++) {
                appendedHtml += allItems[i].outerHTML;
            }

            sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
                html: appendedHtml,
                nextPage: nextPage,
                scrollY: window.scrollY
            }));
        } catch(e) {}
    }

    function loadNextPage() {
        if (loading || nextPage > lastPage || !isMobile()) return;
        loading = true;
        loader.style.display = '';

        var url = new URL(window.location.href);
        url.searchParams.set('p', nextPage);

        fetch(url.toString(), {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'include'
        })
        .then(function(r) { return r.text(); })
        .then(function(html) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(html, 'text/html');
            var newGrid = doc.getElementById('product-grid');

            if (newGrid) {
                var items = newGrid.querySelectorAll(':scope > li');
                var fragment = document.createDocumentFragment();
                items.forEach(function(li) {
                    fragment.appendChild(document.adoptNode(li));
                });
                grid.appendChild(fragment);
                reinitAlpine();
            }

            nextPage++;
            loading = false;
            loader.style.display = 'none';

            if (nextPage > lastPage) {
                endMsg.style.display = '';
                if (observer) observer.disconnect();
            }

            saveState();
        })
        .catch(function() {
            loading = false;
            loader.style.display = 'none';
        });
    }

    function reinitAlpine() {
        if (typeof Alpine !== 'undefined') {
            Alpine.initTree(grid);
        }
    }

    var observer = null;
    function setupObserver() {
        if (!sentinel || observer) return;
        if (nextPage > lastPage) {
            if (isMobile()) endMsg.style.display = '';
            return;
        }

        observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting && isMobile()) {
                    loadNextPage();
                }
            });
        }, { rootMargin: '0px 0px 400px 0px' });

        observer.observe(sentinel);
    }

    document.addEventListener('click', function(e) {
        var link = e.target.closest('a[href]');
        if (link && isMobile()) {
            saveState();
        }
    });

    window.addEventListener('pagehide', function() { saveState(); });

    tryRestore();
    setupObserver();

})();
</script>
