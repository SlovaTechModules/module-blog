<?php
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Slova\Blog\Block\PostList;
use Slova\Imaging\ViewModel\Image as ImageVm;

/** @var PostList $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var ImageVm $imageVm */
$imageVm = $viewModels->require(ImageVm::class);

$posts = $block->getPosts();
$totalCount = (int)$posts->getSize();
?>

<?php if ($totalCount === 0): ?>
    <div class="slova-blog-empty">
        <p><?= $escaper->escapeHtml(__('Nu există încă articole publicate.')) ?></p>
    </div>
<?php else: ?>

<section id="product-list"
         class="slova-blog-section"
         data-current-page="<?= (int)$block->getCurrentPage() ?>"
         data-last-page="<?= (int)$block->getLastPage() ?>"
         aria-label="<?= $escaper->escapeHtmlAttr(__('Listă articole')) ?>"
         tabindex="-1">
    <ul id="product-grid" role="list" class="slova-blog-list">
        <?php foreach ($posts->getItems() as $i => $post): ?>
            <?php
            $postUrl       = $block->getPostUrl((string)$post->getUrlKey());
            $imgPath       = $block->getFeaturedImagePath($post);
            $mobilePath    = $block->getThumbnailMobilePath($post);
            $categories    = $block->getCategoriesForPost($post);
            $shortContent  = trim((string)$post->getShortContent());
            $isLcp         = ($i === 0);
            $alt           = (string)($post->getFeaturedImageAlt() ?: $post->getTitle());
            $altMobile     = (string)($post->getThumbnailMobileAlt() ?: $alt);
            $loading       = $isLcp ? 'eager' : 'lazy';
            $fetchPriority = $isLcp ? 'high' : 'auto';
            ?>
            <li>
                <article class="slova-blog-card">
                    <a href="<?= $escaper->escapeUrl($postUrl) ?>" class="slova-blog-card__thumb" aria-hidden="true" tabindex="-1">
                        <?php if ($imgPath && $mobilePath): ?>
                            <picture>
                                <source type="image/webp"
                                        media="(max-width: <?= PostList::MOBILE_BREAKPOINT_PX - 1 ?>px)"
                                        srcset="<?= $escaper->escapeUrl($block->processImage($mobilePath, 480, 'webp')) ?> 1x, <?= $escaper->escapeUrl($block->processImage($mobilePath, 960, 'webp')) ?> 2x">
                                <source type="image/webp"
                                        srcset="<?= $escaper->escapeUrl($block->processImage($imgPath, 480, 'webp')) ?> 1x, <?= $escaper->escapeUrl($block->processImage($imgPath, 960, 'webp')) ?> 2x">
                                <source media="(max-width: <?= PostList::MOBILE_BREAKPOINT_PX - 1 ?>px)"
                                        srcset="<?= $escaper->escapeUrl($block->processImage($mobilePath, 480, 'jpg')) ?> 1x, <?= $escaper->escapeUrl($block->processImage($mobilePath, 960, 'jpg')) ?> 2x">
                                <img src="<?= $escaper->escapeUrl($block->processImage($imgPath, 480, 'jpg')) ?>"
                                     srcset="<?= $escaper->escapeUrl($block->processImage($imgPath, 480, 'jpg')) ?> 1x, <?= $escaper->escapeUrl($block->processImage($imgPath, 960, 'jpg')) ?> 2x"
                                     alt="<?= $escaper->escapeHtmlAttr($alt) ?>"
                                     loading="<?= $escaper->escapeHtmlAttr($loading) ?>"
                                     <?php if ($fetchPriority !== 'auto'): ?>fetchpriority="<?= $escaper->escapeHtmlAttr($fetchPriority) ?>"<?php endif; ?>
                                     class="slova-blog-card__img">
                            </picture>
                        <?php elseif ($imgPath): ?>
                            <?= /* @noEscape */ $imageVm->picture(
                                $imgPath,
                                480,
                                alt: $alt,
                                loading: $loading,
                                fetchPriority: $fetchPriority,
                                imgClass: 'slova-blog-card__img'
                            ) ?>
                        <?php else: ?>
                            <span class="slova-blog-card__placeholder" aria-hidden="true"></span>
                        <?php endif; ?>
                    </a>
                    <div class="slova-blog-card__body">
                        <h2 class="slova-blog-card__title">
                            <a href="<?= $escaper->escapeUrl($postUrl) ?>">
                                <?= $escaper->escapeHtml($post->getTitle()) ?>
                            </a>
                        </h2>
                        <p class="slova-blog-card__excerpt">
                            <?= $escaper->escapeHtml($shortContent) ?>
                        </p>
                        <div class="slova-blog-card__meta">
                            <?php foreach ($categories as $cat): ?>
                                <a href="<?= $escaper->escapeUrl($block->getCategoryUrl((string)$cat->getUrlKey())) ?>"
                                   class="slova-blog-card__category">
                                    <?= $escaper->escapeHtml($cat->getName()) ?>
                                </a>
                            <?php endforeach; ?>
                        </div>
                    </div>
                </article>
            </li>
        <?php endforeach; ?>
    </ul>

    <div class="slova-blog-pager hidden md:block">
        <?= /* @noEscape */ $block->getPagerHtml() ?>
    </div>

    <?= /* @noEscape */ $block->fetchView($block->getTemplateFile('Slova_Blog::post/list/js/infinite-scroll.phtml')) ?>
</section>

<?php endif; ?>
