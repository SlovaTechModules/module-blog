<?php
/**
 * Slova_Blog — post cards of the blog home and category pages.
 * Phones get one column and load the next pages while scrolling (js/blog.phtml);
 * larger screens get two or three columns and a pager.
 * Copyright © Slova. Licensed under the MIT License, see LICENSE.
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Slova\Blog\Block\PostList;
use Slova\Blog\ViewModel\Image;

/** @var PostList $block */
/** @var Escaper $escaper */

/** @var Image $imageVm */
$imageVm = $block->getData('image_view_model');
$posts = $block->getPosts();
$mobileMax = PostList::MOBILE_BREAKPOINT_PX - 1;
?>
<?php if (!$block->isTitleBandEnabled()): ?>
    <h1 class="slova-blog-heading"><?= $escaper->escapeHtml($block->getHeading()) ?></h1>
<?php endif; ?>

<?php if (!(int)$posts->getSize()): ?>
    <p class="slova-blog-empty"><?= $escaper->escapeHtml(__('No posts have been published yet.')) ?></p>
    <?php return; ?>
<?php endif; ?>

<section id="slova-blog-list"
         class="slova-blog-section"
         data-current-page="<?= (int)$block->getCurrentPage() ?>"
         data-last-page="<?= (int)$block->getLastPage() ?>"
         aria-label="<?= $escaper->escapeHtmlAttr(__('Blog posts')) ?>">
    <ul id="slova-blog-grid" class="slova-blog-list" role="list">
        <?php foreach (array_values($posts->getItems()) as $i => $post): ?>
            <?php
            $postUrl = $block->getPostUrl((string)$post->getUrlKey());
            $imgPath = $block->getFeaturedImagePath($post);
            $mobilePath = $block->getThumbnailMobilePath($post);
            $alt = (string)($post->getFeaturedImageAlt() ?: $post->getTitle());
            $isFirst = $i === 0 && $block->getCurrentPage() === 1;
            $loading = $isFirst ? 'eager' : 'lazy';
            ?>
            <li>
                <article class="slova-blog-card">
                    <a href="<?= $escaper->escapeUrl($postUrl) ?>" class="slova-blog-card__thumb" tabindex="-1" aria-hidden="true">
                        <?php if ($imgPath && $mobilePath): ?>
                            <picture>
                                <?php if ($block->isResponsiveImagesEnabled()): ?>
                                    <source type="image/webp" media="(max-width: <?= (int)$mobileMax ?>px)"
                                            srcset="<?= $escaper->escapeHtml($imageVm->srcset($mobilePath, 480, 'webp')) ?>">
                                    <source type="image/webp"
                                            srcset="<?= $escaper->escapeHtml($imageVm->srcset($imgPath, 480, 'webp')) ?>">
                                <?php endif; ?>
                                <source media="(max-width: <?= (int)$mobileMax ?>px)"
                                        srcset="<?= $escaper->escapeHtml($imageVm->srcset($mobilePath, 480, 'jpg')) ?>">
                                <img src="<?= $escaper->escapeUrl($imageVm->url($imgPath, 480, 'jpg')) ?>"
                                     srcset="<?= $escaper->escapeHtml($imageVm->srcset($imgPath, 480, 'jpg')) ?>"
                                     alt="<?= $escaper->escapeHtmlAttr($alt) ?>"
                                     loading="<?= /* @noEscape */ $loading ?>"
                                     <?php if ($isFirst): ?>fetchpriority="high"<?php endif; ?>
                                     class="slova-blog-card__img">
                            </picture>
                        <?php elseif ($imgPath): ?>
                            <?= /* @noEscape */ $imageVm->picture(
                                $imgPath,
                                480,
                                alt: $alt,
                                loading: $loading,
                                fetchPriority: $isFirst ? 'high' : 'auto',
                                imgClass: 'slova-blog-card__img'
                            ) ?>
                        <?php else: ?>
                            <span class="slova-blog-card__placeholder"></span>
                        <?php endif; ?>
                    </a>
                    <div class="slova-blog-card__body">
                        <h2 class="slova-blog-card__title">
                            <a href="<?= $escaper->escapeUrl($postUrl) ?>"><?= $escaper->escapeHtml($post->getTitle()) ?></a>
                        </h2>
                        <p class="slova-blog-card__excerpt"><?= $escaper->escapeHtml(trim((string)$post->getShortContent())) ?></p>
                        <div class="slova-blog-card__meta">
                            <?php foreach ($block->getCategoriesForPost($post) as $category): ?>
                                <a href="<?= $escaper->escapeUrl($block->getCategoryUrl((string)$category->getUrlKey())) ?>"
                                   class="slova-blog-pill"><?= $escaper->escapeHtml($category->getName()) ?></a>
                            <?php endforeach; ?>
                        </div>
                    </div>
                </article>
            </li>
        <?php endforeach; ?>
    </ul>

    <div class="slova-blog-pager">
        <?= /* @noEscape */ $block->getPagerHtml() ?>
    </div>

    <div class="slova-blog-scroll-status" data-slova-blog-loader hidden>
        <span class="slova-blog-scroll-status__spinner" aria-hidden="true"></span>
        <span><?= $escaper->escapeHtml(__('Loading...')) ?></span>
    </div>
    <div class="slova-blog-scroll-status" data-slova-blog-end hidden>
        <?= $escaper->escapeHtml(__('You have seen all posts')) ?>
    </div>
    <div class="slova-blog-scroll-sentinel" data-slova-blog-sentinel></div>
</section>
