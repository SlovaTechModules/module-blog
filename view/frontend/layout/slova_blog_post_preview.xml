<?xml version="1.0"?>
<!-- Preview of a post from the admin: the post page plus a notice. The notice block is not
     cacheable, which keeps the whole page out of the full page cache. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="2columns-right"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="slova_blog_post_view"/>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="slova.blog.preview.notice"
                   template="Slova_Blog::post/preview-notice.phtml"
                   before="-"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
