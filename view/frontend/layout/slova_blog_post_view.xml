<?xml version="1.0"?>
<!-- A single post. catalog_list_item brings Hyvä's product card for the related products slider. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="2columns-right"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="slova_blog_default"/>
    <update handle="catalog_list_item"/>
    <body>
        <referenceBlock name="head.additional">
            <block class="Slova\Blog\Block\Head\StructuredData"
                   name="slova.blog.post.structured.data"
                   template="Slova_Blog::head/structured-data.phtml"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="slova.blog.head.post.css"
                   template="Slova_Blog::head/post-css.phtml"/>
        </referenceBlock>
        <referenceBlock name="slova.blog.header.band">
            <arguments>
                <argument name="heading" xsi:type="boolean">false</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Slova\Blog\Block\PostView"
                   name="slova.blog.post.view"
                   template="Slova_Blog::post/view.phtml">
                <arguments>
                    <argument name="image_view_model" xsi:type="object">Slova\Blog\ViewModel\Image</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
