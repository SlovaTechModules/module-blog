<?xml version="1.0"?>
<!-- Post list: the blog home and category pages. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="slova_blog_default"/>
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="slova.blog.head.list.css"
                   template="Slova_Blog::head/list-css.phtml"/>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Slova\Blog\Block\PostList"
                   name="slova.blog.post.list"
                   template="Slova_Blog::post/list.phtml">
                <arguments>
                    <argument name="apply_page_meta" xsi:type="boolean">true</argument>
                    <argument name="image_view_model" xsi:type="object">Slova\Blog\ViewModel\Image</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
