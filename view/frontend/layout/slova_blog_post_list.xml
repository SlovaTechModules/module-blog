<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="columns.top">
            <block class="Slova\Blog\Block\HeaderBand"
                   name="slova.blog.header.band"
                   template="Slova_Blog::header-band.phtml">
                <arguments>
                    <argument name="default_title" xsi:type="string" translate="true">Jurnal de bord</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Slova\Blog\Block\PostList"
                   name="slova.blog.post.list"
                   template="Slova_Blog::post/list.phtml"
                   cacheable="true"/>
        </referenceContainer>
        <referenceContainer name="sidebar.additional">
            <block class="Slova\Blog\Block\Sidebar\Categories"
                   name="slova.blog.sidebar.categories"
                   template="Slova_Blog::sidebar/categories.phtml"
                   cacheable="true"/>
            <block class="Carusel\Collections\Block\Frontend\BestsellerProducts"
                   name="slova.blog.sidebar.bestsellers"
                   template="Carusel_Collections::product/bestsellers-sidebar.phtml"
                   cacheable="true">
                <arguments>
                    <argument name="product_count" xsi:type="number">5</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
