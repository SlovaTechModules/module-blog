<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">slova_blog_post_form.slova_blog_post_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Post</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Slova\Blog\Block\Adminhtml\Post\Edit\BackButton"/>
            <button name="delete" class="Slova\Blog\Block\Adminhtml\Post\Edit\DeleteButton"/>
            <button name="view" class="Slova\Blog\Block\Adminhtml\Post\Edit\ViewButton"/>
            <button name="preview" class="Slova\Blog\Block\Adminhtml\Post\Edit\PreviewButton"/>
            <button name="save_draft" class="Slova\Blog\Block\Adminhtml\Post\Edit\SaveDraftButton"/>
            <button name="save" class="Slova\Blog\Block\Adminhtml\Post\Edit\SaveButton"/>
            <button name="save_and_continue" class="Slova\Blog\Block\Adminhtml\Post\Edit\SaveAndContinueButton"/>
        </buttons>
        <namespace>slova_blog_post_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>slova_blog_post_form.slova_blog_post_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="slova_blog_post_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="slova_blog/post/save"/>
        </settings>
        <dataProvider class="Slova\Blog\Model\Post\DataProvider" name="slova_blog_post_form_data_source">
            <settings>
                <requestFieldName>post_id</requestFieldName>
                <primaryFieldName>post_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="post_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>post_id</dataScope>
            </settings>
        </field>
        <field name="title" sortOrder="10" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Title</label>
                <dataScope>title</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="url_key" sortOrder="20" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">URL Key</label>
                <dataScope>url_key</dataScope>
                <notice translate="true">Leave empty to generate it from the title.</notice>
            </settings>
        </field>
        <field name="short_content" sortOrder="30" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Short Description</label>
                <dataScope>short_content</dataScope>
                <notice translate="true">Shown on the post card in the list. One or two sentences, no HTML.</notice>
            </settings>
        </field>
        <field name="content" sortOrder="40" formElement="wysiwyg">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="wysiwygConfigData" xsi:type="array">
                        <item name="is_pagebuilder_enabled" xsi:type="boolean">false</item>
                        <item name="add_variables" xsi:type="boolean">false</item>
                        <item name="add_widgets" xsi:type="boolean">false</item>
                        <item name="toggle_wysiwyg" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
            <settings>
                <label translate="true">Content</label>
                <dataType>text</dataType>
                <dataScope>content</dataScope>
            </settings>
            <formElements>
                <wysiwyg>
                    <settings>
                        <wysiwyg>true</wysiwyg>
                    </settings>
                </wysiwyg>
            </formElements>
        </field>
        <field name="featured_image" sortOrder="50" formElement="imageUploader">
            <settings>
                <label translate="true">Featured Image</label>
                <componentType>imageUploader</componentType>
                <dataScope>featured_image</dataScope>
                <notice translate="true">Used on the post card and, as a hero, on the post page. Recommended ratio 16:9.</notice>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg gif png webp</allowedExtensions>
                        <maxFileSize>5242880</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">slova_blog/post_image/upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="featured_image_alt" sortOrder="55" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Featured Image Alt Text</label>
                <dataScope>featured_image_alt</dataScope>
                <notice translate="true">Describes the image for screen readers and search engines.</notice>
            </settings>
        </field>
        <field name="thumbnail_mobile" sortOrder="56" formElement="imageUploader">
            <settings>
                <label translate="true">Mobile Thumbnail (optional)</label>
                <componentType>imageUploader</componentType>
                <dataScope>thumbnail_mobile</dataScope>
                <notice translate="true">Used on the post card below 768px. Recommended ratio 1:1. Leave empty to use the featured image everywhere.</notice>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg gif png webp</allowedExtensions>
                        <maxFileSize>5242880</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">slova_blog/post_image/upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="thumbnail_mobile_alt" sortOrder="58" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Mobile Thumbnail Alt Text</label>
                <dataScope>thumbnail_mobile_alt</dataScope>
                <notice translate="true">Optional. Falls back to the featured image alt text.</notice>
            </settings>
        </field>
        <field name="show_featured_image" sortOrder="59" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Show Featured Image as Hero</label>
                <dataScope>show_featured_image</dataScope>
                <notice translate="true">The featured image is always used on the post card. Choose whether it also appears as a wide banner at the top of the post page. Turn it off when you use the intro section below. Even when on, the banner is left out if the same picture is the intro image or appears in the content.</notice>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="category_ids" sortOrder="60" formElement="multiselect">
            <settings>
                <dataType>int</dataType>
                <label translate="true">Categories</label>
                <dataScope>category_ids</dataScope>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Slova\Blog\Model\Source\Categories"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="related_skus" sortOrder="70" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Related Products (SKUs)</label>
                <dataScope>related_skus</dataScope>
                <notice translate="true">Comma-separated SKUs, shown in a product slider under the post. Unknown SKUs are ignored.</notice>
            </settings>
        </field>
        <field name="is_active" sortOrder="80" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="published_at" sortOrder="90" formElement="date">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Published At</label>
                <dataScope>published_at</dataScope>
                <notice translate="true">Leave empty to use the creation date. Set a future date to schedule the post.</notice>
            </settings>
            <formElements>
                <date>
                    <settings>
                        <options>
                            <option name="showsTime" xsi:type="boolean">true</option>
                            <option name="dateFormat" xsi:type="string">yyyy-MM-dd HH:mm:ss</option>
                            <option name="timeFormat" xsi:type="string">HH:mm:ss</option>
                        </options>
                    </settings>
                </date>
            </formElements>
        </field>
    </fieldset>

    <fieldset name="intro">
        <settings>
            <label translate="true">Intro Section (alternative to the hero)</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="side_text" sortOrder="10" formElement="textarea">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="rows" xsi:type="number">10</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Intro Text</label>
                <dataScope>side_text</dataScope>
                <notice translate="true">Shown in the left column, aligned right. For bold, wrap text in &lt;strong&gt;…&lt;/strong&gt;; for italic, in &lt;em&gt;…&lt;/em&gt;. Example: a &lt;em&gt;wonderful&lt;/em&gt; story about &lt;strong&gt;courage&lt;/strong&gt;. Press Enter for a new line and Enter twice for a new paragraph. Other HTML tags are ignored.</notice>
            </settings>
        </field>
        <field name="side_image" sortOrder="20" formElement="imageUploader">
            <settings>
                <label translate="true">Intro Image</label>
                <componentType>imageUploader</componentType>
                <dataScope>side_image</dataScope>
                <notice translate="true">Shown in the right column, aligned left. Any ratio (portrait, square or landscape) is shown at its natural size.</notice>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg gif png webp</allowedExtensions>
                        <maxFileSize>5242880</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">slova_blog/post_image/upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="side_image_alt" sortOrder="30" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Intro Image Alt Text</label>
                <dataScope>side_image_alt</dataScope>
            </settings>
        </field>
    </fieldset>

    <fieldset name="seo">
        <settings>
            <label translate="true">SEO</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="meta_title" sortOrder="10" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Title</label>
                <dataScope>meta_title</dataScope>
                <notice translate="true">Falls back to the post title.</notice>
            </settings>
        </field>
        <field name="meta_description" sortOrder="20" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Description</label>
                <dataScope>meta_description</dataScope>
                <notice translate="true">Falls back to the short description.</notice>
            </settings>
        </field>
        <field name="meta_robots" sortOrder="30" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Robots</label>
                <dataScope>meta_robots</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Slova\Blog\Model\Source\MetaRobots"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="og_image" sortOrder="40" formElement="imageUploader">
            <settings>
                <label translate="true">Open Graph Image</label>
                <componentType>imageUploader</componentType>
                <dataScope>og_image</dataScope>
                <notice translate="true">Shown when the post is shared on social networks. Falls back to the featured image. Recommended size 1200×630.</notice>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg png webp</allowedExtensions>
                        <maxFileSize>5242880</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">slova_blog/post_image/upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
    </fieldset>

</form>
