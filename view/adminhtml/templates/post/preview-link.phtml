<?php
/** @var \Slova\Blog\Block\Adminhtml\Post\Edit\PreviewLink $block */
$url = $block->getPostUrl();
?>
<div class="admin__field" style="padding: 1rem 0;">
    <?php if ($url): ?>
        <p style="margin: 0 0 .5rem;">
            <strong><?= /** @noEscape */ __('URL public:') ?></strong>
        </p>
        <p style="margin: 0;">
            <a href="<?= $block->escapeUrl($url) ?>" target="_blank" rel="noopener" style="word-break: break-all;">
                <?= $block->escapeHtml($url) ?> ↗
            </a>
        </p>
    <?php else: ?>
        <p style="margin: 0; color: #777;">
            <?= /** @noEscape */ __('Salvează articolul pentru a vedea URL-ul public.') ?>
        </p>
    <?php endif; ?>
</div>
