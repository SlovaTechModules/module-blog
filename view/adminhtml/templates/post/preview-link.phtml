declare(strict_types=1);

use Magento\Framework\Escaper;
use Slova\Blog\Block\Adminhtml\Post\Edit\PreviewLink;

/** @var PreviewLink $block */
/** @var Escaper $escaper */

$url = $block->getPostUrl();
?>
<div class="admin__field">
    <?php if ($url): ?>
        <p><strong><?= $escaper->escapeHtml(__('Public URL:')) ?></strong></p>
        <p>
            <a href="<?= $escaper->escapeUrl($url) ?>" target="_blank" rel="noopener">
                <?= $escaper->escapeHtml($url) ?> ↗
            </a>
        </p>
    <?php else: ?>
        <p><?= $escaper->escapeHtml(__('Save the post to see its public URL.')) ?></p>
    <?php endif; ?>
</div>
